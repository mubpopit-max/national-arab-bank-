# Copy to your hosting provider's secret manager; never commit real values.
FLASK_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
FOUNDER_PASSWORD=SET_A_STRONG_UNIQUE_PASSWORD
FOUNDER_PIN=SET_FOUR_DIGITS
NAB_DATABASE=/persistent/path/empire_estory.db
EMPIRE_IMAGE_DIR=/persistent/path/uploads/empire
SESSION_COOKIE_SECURE=1
EMPIRE_DATA_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY_AND_STORE_IT_SECURELY
EMPIRE_BINANCE_ID=
PORT=8000
